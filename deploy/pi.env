# Settings preset for a Raspberry Pi edge box (CPU only).
# pi-install.sh copies this to next-gen-backend/.env on first install.
#
# A Pi is several times slower than a desktop CPU, so this trades frame rate
# and image size for staying real-time. Raise the numbers if the Pi keeps up
# (watch "analysed/s" under /api/v1/cameras/status).

APP_ENV=edge
DEVICE=cpu
LOG_LEVEL=INFO
LOG_JSON=false

# Phones and PCs on the site network may open the dashboard.
CORS_ORIGINS=lan

DATABASE_URL=sqlite:///./nexgen.db
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage

FACE_STORE_PATH=storage/models/identity_store.pkl
WEAPON_MODEL_PATH=storage/models/weapon_detector.pt

# --- Throughput ---
MAX_CAMERAS=4
STREAM_SAMPLE_FPS=2.0
STREAM_INFERENCE_WIDTH=640
INFERENCE_MAX_CONCURRENT=1

# Object detection is the heaviest step: small image, every third frame.
WEAPON_INFERENCE_SIZE=320
WEAPON_EVERY_N_FRAMES=3
WEAPON_CONFIDENCE_THRESHOLD=0.40

# --- Plug and play ---
AUTO_START_CAMERAS=true
AUTO_DISCOVER_ON_START=true
# Set these to connect recorders and IP cameras with no one at the screen.
CAMERA_DEFAULT_USERNAME=
CAMERA_DEFAULT_PASSWORD=

# --- Evidence ---
ENABLE_EVENT_CLIPS=true
CLIP_PRE_SECONDS=3.0
CLIP_POST_SECONDS=5.0
ARTIFACT_RETENTION_DAYS=7

# --- Alibaba Cloud (optional) ---
DASHSCOPE_API_KEY=
ENABLE_QWEN_SCENE_POLLING=false
